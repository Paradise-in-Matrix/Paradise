{:deps {:aliases [:dev]}
 :builds
 {:app {:target :esm
        :npm-deps false
        :build-hooks [[lambda-lifter/hook]
                      [build-hooks/include-root-files]
                      [build-hooks/include-themes]
                      [build-hooks/stamp-version]
                      [build-hooks/include-css]
                      [build-hooks/copy-wasm]
                      [build-hooks/copy-element-call]
                      ]
        :output-dir "build"
        :asset-path "/"
        :modules {:base   {:entries []}
                  :eve-shared {:entries [eve.alpha]
                               :depends-on #{:base}}
                  :main   {:entries [client.core]
                           :depends-on #{:eve-shared}
                           :exports {init client.core/init}}
                  :sw     {:entries [service-worker]
                           :web-worker true
                           :depends-on #{:base}}
                  :engine {:entries [worker.core]
                           :web-worker true
                           :depends-on #{:base}}
                           :depends-on #{:base}
                           #_#{:eve-shared}

                           }
                  :virtualizer {:entries [virtualizer.base]
                                :web-worker true
                                :depends-on #{:eve-shared}}}

        :js-options
        {:js-provider :import
         :esm-js-shim false
         :loader {".css" :css}}
        :compiler-options
        {:optimizations
         :simple
         :output-feature-set :es-next
         :warnings {:undeclared-ns false
                    :undeclared-var false
                    :infer-warning false}}
        :devtools {:after-load client.core/after-load
                   :watch-dir "docs"
                   ;;:devtools-url "."
                   }}}}
